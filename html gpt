<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SMAN 1 Contoh Sejahtera</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <!-- Header / Navbar -->
  <header>
    <div class="container">
      <h1 class="logo">SMAN 1 Contoh Sejahtera</h1>
      <nav>
        <ul>
          <li><a href="#home">Beranda</a></li>
          <li><a href="#about">Tentang</a></li>
          <li><a href="#program">Program</a></li>
          <li><a href="#news">Berita</a></li>
          <li><a href="#contact">Kontak</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- Hero Section -->
  <section id="home" class="hero">
    <div class="hero-content">
      <h2>Selamat Datang di SMAN 1 Contoh Sejahtera</h2>
      <p>Mengembangkan generasi unggul, cerdas, dan berkarakter.</p>
      <a href="#about" class="btn">Pelajari Lebih Lanjut</a>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="about">
    <div class="container">
      <h2>Tentang Sekolah</h2>
      <p>
        SMAN 1 Contoh Sejahtera berdiri sejak tahun 1995 dengan visi menjadi sekolah unggulan dalam prestasi akademik dan non-akademik.
      </p>
    </div>
  </section>

  <!-- Program Section -->
  <section id="program" class="program">
    <div class="container">
      <h2>Program Unggulan</h2>
      <div class="program-list">
        <div class="card">
          <h3>Program Sains</h3>
          <p>Pembelajaran berbasis riset dan eksperimen ilmiah.</p>
        </div>
        <div class="card">
          <h3>Program Bahasa</h3>
          <p>Fokus pada kemampuan komunikasi global dan literasi.</p>
        </div>
        <div class="card">
          <h3>Program Sosial</h3>
          <p>Menumbuhkan empati dan kepemimpinan sosial.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- News Section -->
  <section id="news" class="news">
    <div class="container">
      <h2>Berita Terbaru</h2>
      <div class="news-list">
        <div class="news-item">
          <img src="https://via.placeholder.com/300x200" alt="Berita 1" />
          <h3>Prestasi Siswa di Olimpiade Sains Nasional</h3>
          <p>Siswa SMAN 1 Contoh Sejahtera meraih medali emas bidang Fisika.</p>
        </div>
        <div class="news-item">
          <img src="https://via.placeholder.com/300x200" alt="Berita 2" />
          <h3>Peringatan Hari Guru Nasional</h3>
          <p>Kegiatan spesial untuk menghargai dedikasi para guru.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="contact">
    <div class="container">
      <h2>Kontak Kami</h2>
      <p>Email: info@sman1contoh.sch.id</p>
      <p>Telepon: (021) 123-4567</p>
      <p>Alamat: Jl. Pendidikan No.1, Kota Sejahtera</p>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <p>&copy; 2025 SMAN 1 Contoh Sejahtera. Semua Hak Dilindungi.</p>
  </footer>
</body>
</html>
