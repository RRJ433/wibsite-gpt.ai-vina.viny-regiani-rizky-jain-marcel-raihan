<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SMAN 1 Contoh Sejahtera</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>

  <!-- Header -->
  <header>
    <div class="container header-container">
      <h1 class="logo">SMAN 1 Contoh Sejahtera</h1>
      <nav>
        <ul>
          <li><a href="#home">Beranda</a></li>
          <li><a href="#about">Tentang</a></li>
          <li><a href="#program">Program</a></li>
          <li><a href="#news">Berita</a></li>
          <li><a href="#contact">Kontak</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- Hero Section -->
  <section id="home" class="hero">
    <div class="hero-overlay">
      <div class="hero-content">
        <h2>Selamat Datang di SMAN 1 Contoh Sejahtera</h2>
        <p>Mencetak generasi cerdas, berkarakter, dan berprestasi.</p>
        <a href="#about" class="btn">Pelajari Lebih Lanjut</a>
      </div>
    </div>
  </section>

  <!-- Tentang Sekolah -->
  <section id="about" class="about">
    <div class="container">
      <h2>Tentang Sekolah</h2>
      <p>
        SMAN 1 Contoh Sejahtera berdiri sejak tahun 1995 dengan visi menjadi sekolah unggulan dalam bidang akademik dan non-akademik. 
        Kami berkomitmen untuk menciptakan lingkungan belajar yang kondusif dan inovatif.
      </p>
    </div>
  </section>

  <!-- Program Unggulan -->
  <section id="program" class="program">
    <div class="container">
      <h2>Program Unggulan</h2>
      <div class="program-list">
        <div class="card">
          <h3>Program Sains</h3>
          <p>Pembelajaran berbasis riset dan eksperimen ilmiah.</p>
        </div>
        <div class="card">
          <h3>Program Bahasa</h3>
          <p>Fokus pada kemampuan komunikasi global dan literasi.</p>
        </div>
        <div class="card">
          <h3>Program Sosial</h3>
          <p>Menumbuhkan empati dan kepemimpinan sosial di masyarakat.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Berita Sekolah -->
  <section id="news" class="news">
    <div class="container">
      <h2>Berita Terbaru</h2>
      <div class="news-list">
        <div class="news-item">
          <img src="https://via.placeholder.com/400x250" alt="Berita 1">
          <h3>Prestasi Olimpiade Sains Nasional</h3>
          <p>Siswa SMAN 1 Contoh Sejahtera meraih medali emas di bidang Fisika.</p>
        </div>
        <div class="news-item">
          <img src="https://via.placeholder.com/400x250" alt="Berita 2">
          <h3>Hari Guru Nasional</h3>
          <p>Perayaan Hari Guru dengan berbagai kegiatan dan penghargaan.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Kontak -->
  <section id="contact" class="contact">
    <div class="container">
      <h2>Kontak Kami</h2>
      <p>Email: info@sman1contoh.sch.id</p>
      <p>Telepon: (021) 123-4567</p>
      <p>Alamat: Jl. Pendidikan No. 1, Kota Sejahtera</p>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <p>&copy; 2025 SMAN 1 Contoh Sejahtera. Semua hak dilindungi.</p>
  </footer>

</body>
</html>
