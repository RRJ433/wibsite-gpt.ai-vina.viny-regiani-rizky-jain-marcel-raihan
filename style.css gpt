/* RESET DASAR */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Poppins', sans-serif;
}

body {
  background-color: #f9f9f9;
  color: #333;
  line-height: 1.6;
}

/* HEADER */
header {
  background-color: #004080;
  color: white;
  padding: 15px 0;
  position: sticky;
  top: 0;
  z-index: 1000;
}

.header-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 90%;
  margin: auto;
}

.logo {
  font-size: 1.3rem;
  font-weight: bold;
}

nav ul {
  list-style: none;
  display: flex;
  gap: 20px;
}

nav ul li a {
  color: white;
  text-decoration: none;
  transition: 0.3s;
}

nav ul li a:hover {
  text-decoration: underline;
}

/* HERO SECTION */
.hero {
  height: 80vh;
  background: url('https://via.placeholder.com/1200x600') center/cover no-repeat;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-overlay {
  background: rgba(0, 0, 0, 0.5);
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-content {
  text-align: center;
  color: white;
  padding: 20px;
}

.hero-content h2 {
  font-size: 2rem;
  margin-bottom: 10px;
}

.btn {
  display: inline-block;
  margin-top: 15px;
  padding: 10px 25px;
  background: #ffcc00;
  color: #333;
  text-decoration: none;
  border-radius: 5px;
  transition: background 0.3s;
}

.btn:hover {
  background: #ffaa00;
}

/* SECTION UMUM */
section {
  padding: 60px 0;
}

.container {
  width: 90%;
  max-width: 1100px;
  margin: auto;
}

h2 {
  text-align: center;
  color: #004080;
  margin-bottom: 30px;
}

/* PROGRAM */
.program-list {
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  gap: 20px;
}

.card {
  background: #fff;
  padding: 25px;
  width: 300px;
  text-align: center;
  border-radius: 10px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.card h3 {
  color: #004080;
  margin-bottom: 10px;
}

/* BERITA */
.news-list {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 20px;
}

.news-item {
  background: #fff;
  width: 320px;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.news-item img {
  width: 100%;
  height: 200px;
  object-fit: cover;
}

.news-item h3 {
  margin: 10px;
  color: #004080;
}

.news-item p {
  margin: 0 10px 15px;
}

/* KONTAK */
.contact p {
  text-align: center;
  margin: 5px 0;
}

/* FOOTER */
footer {
  background-color: #004080;
  color: white;
  text-align: center;
  padding: 15px 0;
  margin-top: 30px;
}
